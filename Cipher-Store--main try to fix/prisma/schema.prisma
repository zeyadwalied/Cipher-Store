generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("USER") // 'USER', 'SUPPORT', 'SELLER', 'MANAGER', 'OWNER', 'DEV'
  isBlocked     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  products      Product[] // For sellers
  chatsAsBuyer  Chat[]    @relation("BuyerChats")
  chatsAsSeller Chat[]    @relation("SellerChats")
  assignedChats Chat[]    @relation("AssignedChats")
  messages      Message[]
  reviews       Review[]
}

model Category {
  id              String     @id @default(cuid())
  slug            String?    @unique
  name            String
  description     String?
  imageUrl        String?    // Category Thumbnail
  backgroundImageUrl String? // Category Section Background
  isAutomaticOnly Boolean    @default(false)
  sortOrder       Int        @default(0)
  
  // Hierarchy
  parentId        String?
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryHierarchy")

  products        Product[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  slug        String?  @unique
  name        String
  description String
  price       Float
  image        String?
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id])
  deliveryType String       @default("MANUAL") // "MANUAL" or "AUTOMATIC"
  stockQuantity Int?        // Null means unlimited stock. Integer means limited stock.
  stockItems   StockItem[]
  sellerId    String?
  seller      User?    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
  reviews     Review[]
}

model Order {
  id            String      @id @default(cuid())
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  status        String      @default("PENDING") // PENDING, PAID, COMPLETED, CANCELLED
  total         Float
  paymentMethod String      // VODAFONE_CASH, INSTAPAY, PAYPAL, CREDIT_CARD
  
  // Manual Payment Verification Fields
  senderPhoneNumber String?
  receiptImageUrl   String?
  discordChannelId  String?
  confirmationSource String? // 'DISCORD' or 'WEBSITE'
  confirmedByName    String? // Discord username who confirmed
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
  chat          Chat?
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity    Int
  price       Float
  stockItems  StockItem[]
}

model StockItem {
  id          String     @id @default(cuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  data        String     // The actual account details or CD key
  isUsed      Boolean    @default(false)
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Chat {
  id           String    @id @default(cuid())
  type         String    @default("SUPPORT") // 'SUPPORT' or 'ORDER'
  orderId      String?   @unique
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId      String?
  buyer        User?      @relation("BuyerChats", fields: [buyerId], references: [id], onDelete: SetNull)
  sellerId     String?
  seller       User?     @relation("SellerChats", fields: [sellerId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?     @relation("AssignedChats", fields: [assignedToId], references: [id], onDelete: SetNull)
  status       String    @default("ONGOING") // 'ONGOING' or 'SUCCESS'
  discordChannelId String?
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId  String?  // Null if AI
  sender    User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  content   String
  isAi      Boolean  @default(false)
  discordMessageId String?
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1 to 5
  comment   String?
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Discount {
  id                  String    @id @default(cuid())
  name                String
  type                String    // 'SINGLE', 'CATEGORY', 'GENERAL', 'MIXED'
  value               Float
  isPercentage        Boolean   @default(true)
  isActive            Boolean   @default(true)
  
  // Targets for SINGLE or CATEGORY
  targetProductId     String?
  targetCategoryId    String?
  
  // Excluders for GENERAL (stored as JSON arrays in string format for SQLite)
  excludedProductIds  String?
  excludedCategoryIds String?
  
  // Logical conditions for MIXED (e.g., must buy from Product X AND Category Y)
  mixedConditionType  String?   // 'AND' or 'OR'
  mixedProductId      String?
  mixedCategoryId     String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  name      String?
  password  String?
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
